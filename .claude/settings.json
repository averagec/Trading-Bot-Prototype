{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_live.py\"",
            "timeout": 300,
            "statusMessage": "Checking live bot code (compile + live tests)..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest research/tests*)",
      "Bash(python -m py_compile *)",
      "Bash(python -m research.run *)",
      "Bash(python -m research.nulltest *)",
      "Bash(python -m research.decompose *)",
      "Bash(python -m research.compare_live)",
      "Bash(python -m research.experiments *)",
      "Bash(python -m research.ideas.evaluate *)",
      "Bash(python -m research.data_tools quality *)",
      "Bash(python -m research.data_tools probe)",
      "Bash(python -m research.data_tools synth *)"
    ],
    "deny": [
      "Bash(python main.py*)",
      "Bash(python ./main.py*)",
      "Bash(python -u main.py*)",
      "Bash(python -m main*)",
      "Bash(python validate.py*)"
    ],
    "ask": [
      "Bash(python -m research.ideas.evaluate holdout*)",
      "Bash(python -m research.fetch_data*)"
    ]
  }
}